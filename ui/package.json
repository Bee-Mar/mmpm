{
  "name": "MMPM-UI",
  "version": "5.0.1",
  "scripts": {
    "ng": "./node_modules/@angular/cli/bin/ng.js",
    "start": "./node_modules/@angular/cli/bin/ng.js serve",
    "serve": "./node_modules/@angular/cli/bin/ng.js serve",
    "serve-prod": "./node_modules/@angular/cli/bin/ng.js serve --configuration production",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "build-prod": "node ./node_modules/@angular/cli/bin/ng.js build --configuration production --output-hashing none --base-href /",
    "watch": "./node_modules/@angular/cli/bin/ng.js build --watch --configuration development",
    "lint": "./node_modules/@angular/cli/bin/ng.js lint",
    "test": "./node_modules/@angular/cli/bin/ng.js test",
    "format": "for file in src/app; do ./node_modules/prettier/bin/prettier.cjs --write $file; done",
    "postinstall": "command -v b2n >/dev/null 2>&1 && b2n || true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@primeuix/themes": "^3.0.0",
    "cookie": "^2.0.1",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.56.0",
    "ngx-monaco-editor-v2": "^22.0.5",
    "prettier": "^3.9.6",
    "primeicons": "^8.0.0",
    "primeng": "^22.1.0",
    "qs": "^6.16.0",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tmp": "^0.2.7",
    "tslib": "^2.8.1",
    "typescript-cookie": "^1.0.6",
    "ws": "^8.21.3",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular-eslint/builder": "22.2.0",
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/schematics": "22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/jasmine": "^6.0.0",
    "@types/node": "26.4.0",
    "@typescript-eslint/utils": "^8.69.0",
    "ajv": "^8.20.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "jasmine-core": "^7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
